{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/nabat",
      "destination": "/plant-monitor",
      "permanent": true
    },
    {
      "source": "/nabat/:path*",
      "destination": "/plant-monitor",
      "permanent": true
    },
    {
      "source": "/work/nabat",
      "destination": "/work/plant-monitor",
      "permanent": true
    },
    {
      "source": "/plane-route-jump",
      "destination": "/flights-waypoint",
      "permanent": true
    },
    {
      "source": "/work/plane-route-jump",
      "destination": "/work/flights-waypoint",
      "permanent": true
    },
    {
      "source": "/dalil",
      "destination": "/worth-it",
      "permanent": true
    },
    {
      "source": "/work/dalil",
      "destination": "/work/worth-it",
      "permanent": true
    },
    {
      "source": "/orbit",
      "destination": "/ask-the-satellite",
      "permanent": true
    },
    {
      "source": "/work/orbit",
      "destination": "/work/ask-the-satellite",
      "permanent": true
    },
    {
      "source": "/ready-now",
      "destination": "/sahn-rescue",
      "permanent": true
    },
    {
      "source": "/work/ready-now",
      "destination": "/work/sahn-rescue",
      "permanent": true
    }
  ],
  "functions": {
    "api/ask-the-satellite.js": {
      "maxDuration": 60
    },
    "api/concierge.js": {
      "maxDuration": 60
    },
    "api/tender-memo.js": {
      "maxDuration": 60
    },
    "api/ask-results.js": {
      "maxDuration": 60
    }
  }
}
